project.manifest = manifest.xml

# Type checking disabled: the legacy code (SDK 3.1.0 era) has pre-existing
# signature mismatches in BehaviorDelegate.onKey return types and in the
# callback types passed to Communications.makeWebRequest / Timer.start.
# SDK 9.1.0's gradual type checker rejects these as errors. Fixing them is
# a code change out of scope for the SDK migration; see CLAUDE.md.
project.typecheck = 0

project.manifest = manifest.xml

# Default (debug) builds: drop the (:release) Log.d stub so debug
# logging compiles in. Release builds must additionally pass
# `-x debug` on the monkeyc command line so the (:debug) version is
# excluded and the no-op stub wins. See source/util/Log.mc.
base.excludeAnnotations = release

# Per-device launcher-icon resource folders. The base resources/ directory
# no longer contains launcher_icon.png — each device explicitly picks a size
# folder here so the compiler never sees two candidate icons at once.
# Icon-size requirements per device are taken from each device's
# compiler.json `launcherIcon.width/height`.

# 65x65 launcher slot
fenix847mm.resourcePath = $(base.resourcePath);resources-icon-65
fenix8pro47mm.resourcePath = $(base.resourcePath);resources-icon-65
fr965.resourcePath = $(base.resourcePath);resources-icon-65
fr970.resourcePath = $(base.resourcePath);resources-icon-65

# 60x60 launcher slot
fenix843mm.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro42mm.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro47mm.resourcePath = $(base.resourcePath);resources-icon-60
epix2pro51mm.resourcePath = $(base.resourcePath);resources-icon-60

# 40x40 launcher slot
fenix8solar47mm.resourcePath = $(base.resourcePath);resources-icon-40
fenix8solar51mm.resourcePath = $(base.resourcePath);resources-icon-40

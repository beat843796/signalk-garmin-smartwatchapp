<?xml version="1.0"?>
<!--
  SignalK Connect - Connect IQ watch-app manifest.

  App type is "watch-app" (not "widget") because Fenix 8 / Epix Pro Gen 2 /
  FR970 / FR965 no longer support the legacy widget carousel. A glance view is
  registered below so the app shows up in the glance picker on these devices.

  minApiLevel 5.2.0 is the lowest API level shared by all targeted devices
  (FR965 and Epix Pro Gen 2 are 5.2; Fenix 8 and FR970 are 6.0).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="VesselConnectApp"
        id="cf2d552383bd41ae8867ad78c6b2ec52"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.2.0"
        name="@Strings.AppName"
        type="watch-app"
        version="2.0.0">
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="fr965"/>
            <iq:product id="fr970"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="BluetoothLowEnergy"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
